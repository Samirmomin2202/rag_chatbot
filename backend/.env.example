GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Estimated USD rates per 1M tokens; adjust if your Groq plan/model pricing differs.
GROQ_INPUT_PRICE_PER_MILLION=0.15
GROQ_OUTPUT_PRICE_PER_MILLION=0.60
GROQ_VISION_INPUT_PRICE_PER_MILLION=0.80
GROQ_VISION_OUTPUT_PRICE_PER_MILLION=4.00

MONGODB_URI=your_mongodb_connection_string
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Hybrid PDF retrieval settings. Top-k is the number of passages returned;
# candidate-k controls how many dense and keyword candidates are fused/reranked.
RAG_TOP_K=5
RAG_CANDIDATE_K=30
RAG_LEXICAL_MAX_DOCUMENTS=10000
RAG_RERANK_FUSION_WEIGHT=0.35
RAG_RERANK_BM25_WEIGHT=0.30
RAG_RERANK_SEMANTIC_WEIGHT=0.25
RAG_RERANK_TERM_WEIGHT=0.10
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_PDF_MB=15

# Authentication: generate a long random secret and set a strong admin password.
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_TOKEN_HOURS=12
# Optional social sign-in. Register these callback URLs with each provider:
# http://localhost:8000/api/auth/oauth/google/callback
# http://localhost:8000/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional external search provider. Obtain a key from Tavily and keep it server-side.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
