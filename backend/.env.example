GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Estimated USD rates per 1M tokens; adjust if your Groq plan/model pricing differs.
GROQ_INPUT_PRICE_PER_MILLION=0.15
GROQ_OUTPUT_PRICE_PER_MILLION=0.60
GROQ_VISION_INPUT_PRICE_PER_MILLION=0.80
GROQ_VISION_OUTPUT_PRICE_PER_MILLION=4.00

MONGODB_URI=your_mongodb_connection_string
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_PDF_MB=15

# Authentication: generate a long random secret and set a strong admin password.
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_TOKEN_HOURS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional external search provider. Obtain a key from Tavily and keep it server-side.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
